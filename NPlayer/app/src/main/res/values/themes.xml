<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theming; this only styles the window before the
         first frame. values-night swaps the parent for the dark variant. -->
    <style name="Theme.NPlayer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
